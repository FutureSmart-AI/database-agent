# Local disposable stack only. Copy to .env; never copy a tracked hosted env file.
MODE=standalone
POSTGRES_USER=metadata
POSTGRES_PASSWORD=local-metadata-only
POSTGRES_HOST=metadata-db
POSTGRES_PORT=5432
POSTGRES_DB_NAME=database_agent
# DATABASE_URL, if supplied, takes precedence for BOTH runtime and migrations.
FASTAPI_SECRET_KEY=replace-with-a-random-local-bootstrap-secret
qdrant_url=http://qdrant:6333
qdrant_api_key=
# Inject OPENAI_API_KEY from your shell; Compose forwards it without saving it here.

LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
OTEL_EXPORTER_ENDPOINT=
USAGE_SERVICE_MIRROR=false
USAGE_API_URL=
BUCKET_NAME=
REPORTS_EXECUTOR=inprocess
REPORTS_SCHEDULER_ENABLED=false
AWS_EC2_METADATA_DISABLED=true

# Single-operator standalone UI login; change both secrets before network exposure.
STANDALONE_OWNER_EMAIL=operator@example.test
STANDALONE_LOGIN_PASSWORD=local-installation-only
STANDALONE_ORIGIN=http://localhost:3001
STANDALONE_COOKIE_SECURE=false
