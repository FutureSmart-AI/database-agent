{
  "version": "relational-v1",
  "as_of_exclusive": "2026-02-01T00:00:00Z",
  "cases": [
    {
      "id": "net_region",
      "question": "January completed USD net sales in cents by active-customer region, refunds strictly before as-of2026-02-01.",
      "supported": true,
      "common": true,
      "reference": "reference/net_region.sql",
      "ordered": true,
      "columns": [
        {
          "name": "region",
          "kind": "text",
          "nullable": false
        },
        {
          "name": "net_cents",
          "kind": "integer",
          "nullable": false,
          "unit": "USD_cent"
        }
      ],
      "expected": [
        [
          "North",
          4200
        ],
        [
          "South",
          4000
        ]
      ],
      "negative": [
        {
          "id": "cancelled_included",
          "replace_once": [
            "o.status = 'completed'",
            "o.status IN ('completed', 'cancelled')"
          ]
        },
        {
          "id": "inactive_included",
          "replace_once": [
            "c.active = 1",
            "c.active IN (0, 1)"
          ]
        },
        {
          "id": "end_inclusive",
          "replace_once": [
            "o.ordered_on < '2026-02-01'",
            "o.ordered_on <= '2026-02-01'"
          ]
        },
        {
          "id": "start_previous_day",
          "replace_once": [
            "o.ordered_on >= '2026-01-01'",
            "o.ordered_on >= '2025-12-31'"
          ]
        },
        {
          "id": "future_refund_included",
          "replace_once": [
            "refunded_on < '2026-02-01'",
            "refunded_on < '2026-03-01'"
          ]
        },
        {
          "id": "currency_mixed",
          "replace_once": [
            "o.currency = 'USD'",
            "o.currency IN ('USD', 'EUR')"
          ]
        },
        {
          "id": "dollars_as_cents",
          "replace_once": [
            "SUM(net_cents) AS net_cents",
            "SUM(net_cents) / 100.0 AS net_cents"
          ]
        },
        {
          "id": "wrong_order",
          "replace_once": [
            "ORDER BY region",
            "ORDER BY region DESC"
          ]
        },
        {
          "id": "join_multiplication",
          "file": "wrong_join.sql",
          "common": false
        }
      ]
    },
    {
